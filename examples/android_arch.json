{
  "title": "Android 系统五层架构全景与 Binder IPC / HAL 跨层通信拓扑",
  "canvas": {
    "background": "grid",
    "padding": 36
  },
  "elements": [
    {
      "id": "app_tier",
      "type": "group",
      "title": "1. System Apps & Jetpack Compose 应用层",
      "layout": {
        "type": "flex",
        "direction": "row",
        "gap": 20
      },
      "style": {
        "tone": "primary",
        "variant": "outlined"
      },
      "children": [
        {
          "id": "compose_ui",
          "type": "card",
          "icon": "sparkles",
          "title": "Jetpack Compose / View 树",
          "badge": "UI Thread",
          "body": "Choreographer 接收 VSync 信号 → 执行测量、布局与 RenderNode 录制",
          "style": {
            "tone": "primary",
            "variant": "soft"
          }
        },
        {
          "id": "activity_thread",
          "type": "card",
          "icon": "layers",
          "title": "ActivityThread & Looper",
          "badge": "App Process",
          "body": "epoll 驱动主线程 MessageQueue，通过 ApplicationThread 响应 AMS 调度",
          "style": {
            "tone": "info",
            "variant": "soft"
          }
        }
      ]
    },
    {
      "id": "fw_tier",
      "type": "group",
      "title": "2. Java API Framework (system_server 核心系统服务层)",
      "place": {
        "below": "app_tier",
        "gap": 44,
        "align": "start"
      },
      "layout": {
        "type": "flex",
        "direction": "row",
        "gap": 20
      },
      "style": {
        "tone": "secondary",
        "variant": "outlined"
      },
      "children": [
        {
          "id": "wms_svc",
          "type": "card",
          "icon": "layers",
          "title": "WindowManagerService (WMS)",
          "badge": "WindowToken",
          "body": "管理全局窗口 Surface 树、Z-Order 层级与 InputDispatcher 触控分发",
          "style": {
            "tone": "secondary",
            "variant": "soft"
          }
        },
        {
          "id": "atms_svc",
          "type": "card",
          "icon": "cpu",
          "title": "ActivityTaskManager (ATMS)",
          "badge": "AMS / PMS",
          "body": "管控 Activity 任务栈生命周期、进程 OomAdj 优先级与包管理服务",
          "style": {
            "tone": "primary",
            "variant": "soft"
          }
        }
      ]
    },
    {
      "id": "native_tier",
      "type": "group",
      "title": "3. Native Daemons & Android Runtime (ART 虚拟机与图形合成)",
      "place": {
        "below": "fw_tier",
        "gap": 44,
        "align": "start"
      },
      "layout": {
        "type": "flex",
        "direction": "row",
        "gap": 20
      },
      "style": {
        "tone": "accent",
        "variant": "outlined"
      },
      "children": [
        {
          "id": "surface_flinger",
          "type": "card",
          "icon": "zap",
          "title": "SurfaceFlinger & RenderEngine",
          "badge": "BLASTBufferQueue",
          "body": "消费各应用 GraphicBuffer 图层 → 构建合成列表委托 HWC 硬件叠层",
          "style": {
            "tone": "accent",
            "variant": "soft"
          }
        },
        {
          "id": "art_runtime",
          "type": "card",
          "icon": "code",
          "title": "Android Runtime (ART) & Zygote",
          "badge": "AOT + JIT",
          "body": "dex2oat 混合编译、Generational CC 并发垃圾回收与写时复制进程孵化",
          "style": {
            "tone": "warning",
            "variant": "soft"
          }
        }
      ]
    },
    {
      "id": "binder_ipc_bus",
      "type": "queue",
      "label": "Binder IPC 零拷贝通信总线",
      "sublabel": "mmap 128KB 内核映射 (仅一次拷贝) + AIDL ServiceManager 寻址",
