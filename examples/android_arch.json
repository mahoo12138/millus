        "rightOf": "fw_tier",
        "gap": 68,
        "align": "center"
      },
      "style": {
        "tone": "info",
        "variant": "soft"
      }
    },
    {
      "id": "hal_matrix",
      "type": "table",
      "title": "4. Hardware Abstraction Layer (AIDL / HIDL 硬件抽象层)",
      "place": {
        "below": "binder_ipc_bus",
        "gap": 44,
        "align": "start"
      },
      "headers": [
        "HAL 子系统",
        "IPC 传输机制",
        "独立守护进程"
      ],
      "rows": [
        [
          "Composer HAL",
          {
            "text": "AIDL + Fence 同步栅栏",
            "tone": "accent"
          },
          "vendor.hwcomposer-service"
        ],
        [
          "Camera HAL3",
          {
            "text": "FMQ 快速消息队列 + Gralloc",
            "tone": "primary"
          },
          "camerahalserver"
        ],
        [
          "Audio / NNAPI",
          {
            "text": "ashmem 匿名共享内存",
            "tone": "success"
          },
          "audioserver / neuralnetworks"
        ]
      ],
      "style": {
        "tone": "success",
        "variant": "outlined"
      }
    },
    {
      "id": "linux_kernel",
      "type": "cylinder",
      "label": "5. Linux Kernel (Binder Driver / DRM-KMS / ION-DMA-BUF / WakeLocks)",
      "sublabel": "安全隔离 (SELinux) + 内存共享 (dma_buf) + 硬件设备驱动",
      "place": {
        "below": "native_tier",
        "gap": 48,
        "align": "center"
      },
      "style": {
        "tone": "success",
        "variant": "soft",
        "elevation": "md"
      }
    }
  ],
  "connections": [
    {
      "from": "compose_ui@bottom",
      "to": "wms_svc@top",
      "label": "relayoutWindow",
      "tone": "primary"
    },
    {
      "from": "activity_thread@bottom",
      "to": "atms_svc@top",
      "label": "IActivityClientController",
      "tone": "info"
    },
    {
      "from": "wms_svc@bottom",
      "to": "surface_flinger@top",
      "label": "BLAST 图层事务",
      "tone": "accent",
      "animation": {
        "type": "pulse"
      }
    },
    {
      "from": "atms_svc@bottom",
      "to": "art_runtime@top",
      "label": "Zygote Socket 孵化",
      "tone": "warning"
    },
    {
      "from": "atms_svc@right",
      "to": "binder_ipc_bus@left",
      "label": "Binder 事务分发",
      "tone": "info",
      "animation": {
        "type": "flow"
      }
    },
    {
      "from": "binder_ipc_bus@bottom",
