      "tone": "info"
    },
    {
      "from": "surface_flinger@right",
      "to": "hal_matrix.cell_0_0@left",
      "label": "validateDisplay / present",
      "tone": "accent",
      "animation": {
        "type": "pulse",
        "speed": "fast"
      }
    },
    {
      "from": "surface_flinger@bottom",
      "to": "linux_kernel@top",
      "label": "DRM/KMS 原子翻页",
      "tone": "success"
    },
    {
      "from": "hal_matrix@bottom",
      "to": "linux_kernel@right",
      "label": "ioctl / dma_buf 驱动调用",
      "tone": "success"
    }
  ]
