{
  "title": "React 18 Fiber 并发时间切片与 Vue 3 编译期 PatchFlags 靶向更新",
  "canvas": {
    "background": "dots",
    "padding": 36
  },
  "elements": [
    {
      "id": "vue_sfc",
      "type": "code-block",
      "title": "App.vue → compile() 编译产物",
      "lang": "ts",
      "highlightLines": [
        2,
        4,
        5
      ],
      "code": "const _hoisted_1 = createVNode(\"h1\", null, \"Static\");\nexport function render(_ctx) {\n  return (openBlock(), createElementBlock(\"div\", null, [\n    _hoisted_1,\n    createElementVNode(\"span\", null, _ctx.msg, 1 /* TEXT */)\n  ]));\n}",
      "style": {
        "tone": "success",
        "elevation": "sm"
      }
    },
    {
      "id": "note_patch",
      "type": "callout",
      "text": "编译期静态分析注入 1 /* TEXT */ 位标记，Diff 时直接跳过静态子树！",
      "target": "vue_sfc.line_5",
      "side": "top",
      "style": {
        "tone": "warning"
      }
    },
    {
      "id": "patch_flags",
      "type": "bitfield",
      "title": "Vue 3 PatchFlags 32-bit 靶向位掩码",
