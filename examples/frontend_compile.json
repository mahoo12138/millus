        {
          "name": "CLASS",
          "bits": 4,
          "value": "0x02",
          "tone": "info"
        },
        {
          "name": "STYLE",
          "bits": 4,
          "value": "0x04",
          "tone": "primary"
        },
        {
          "name": "PROPS",
          "bits": 8,
          "value": "0x08",
          "tone": "warning"
        },
        {
          "name": "HOISTED",
          "bits": 12,
          "value": "-1 静态",
          "tone": "neutral"
        }
      ]
    },
    {
      "id": "vue_runtime",
      "type": "group",
      "title": "Vue 3 运行时 Block Tree 靶向 Patch",
